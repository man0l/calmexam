{
  "name": "calmexam-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "calmexam.com website + API (single Cloudflare Worker)",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node build.mjs && node scripts/smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply calmexam --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "indiestack-ai-bots": "^0.1.2"
  }
}
