# Public Expo env vars, inlined into the bundle at build time (EXPO_PUBLIC_ prefix).
# Copy to .env and fill in. In CI these come from GitHub Actions secrets.

# Worker API base URL (folder web/, see docs/API.md). No trailing slash.
EXPO_PUBLIC_API_BASE_URL=https://calmexam.manol-trendafilov.workers.dev/api

# RevenueCat public SDK keys. Each store app has its own key.
# - EXPO_PUBLIC_REVENUECAT_KEY: Android/Play Store key (goog_...). Fallback on iOS.
# - EXPO_PUBLIC_REVENUECAT_IOS_KEY: iOS/App Store key (appl_...).
# - EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY: RevenueCat Test Store key, __DEV__ builds only.
# With no key, dev builds and web use a local stub so the paywall still works.
EXPO_PUBLIC_REVENUECAT_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=

# AppsFlyer SDK dev key (AppsFlyer > App Settings). Same key for the iOS and Android apps.
# Empty disables AppsFlyer; the iOS tracking prompt is still shown.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
